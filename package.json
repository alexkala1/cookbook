{
  "name": "heirloom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "nuxt dev",
    "dev:lan": "NUXT_HOST=0.0.0.0 nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "NITRO_HOST=127.0.0.1 nuxt preview",
    "start": "NITRO_HOST=127.0.0.1 node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-user-flows.js",
    "test:pwa": "node scripts/e2e-offline-flight.js",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/db/seed.ts",
    "mcp": "tsx server/mcp/index.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@nuxt/ui": "^3.0.0",
    "@vueuse/core": "^14.0.0",
    "@vueuse/nuxt": "^14.0.0",
    "better-sqlite3": "^12.0.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.0",
    "h3": "1.15.11",
    "ipaddr.js": "^2.5.0",
    "marked": "^18.0.14",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "drizzle-kit": "^0.31.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
