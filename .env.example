DATABASE_URL=./heirloom.db
# Compose publishes only to loopback; override if port 3000 is occupied.
HEIRLOOM_PORT=3000
# Exact HTTP(S) origin or hostname for the Host allowlist (no paths or wildcards).
# This does not change port exposure or disable same-origin mutation checks.
# Compose reads .env; export these variables explicitly outside Compose.
HEIRLOOM_PUBLIC_HOST=http://localhost:3000
