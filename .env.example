# Settings for `docker compose`, read automatically from this file once copied to .env
# (cp .env.example .env). See docs/SELF_HOSTING.md.

# Port published on the host. Change it if 3000 is already in use.
HEIRLOOM_PORT=3000

# Exact HTTP(S) origin or hostname for the Host allowlist (no paths or wildcards).
# Example: http://localhost:3000 or heirloom.home (when behind a reverse proxy).
HEIRLOOM_PUBLIC_HOST=http://localhost:3000

# Used only when running outside Docker (pnpm dev / pnpm start). Docker Compose sets its own path.
DATABASE_URL=./heirloom.db
